#!/usr/bin/env bash
# uo — ClassicUO REST API wrapper for LLM clients
# Usage: uo <command> [args...]
# Requires: ClassicUO.RestAPI running locally (dotnet run --project src/ClassicUO.RestAPI)

BASE="http://127.0.0.1:9000/api"
J="Content-Type: application/json"

_post() { curl -s -X POST "$BASE/$1" -H "$J" -d "$2"; }
_get()  { curl -s "$BASE/$1"; }

# Convert hex (0x...) serial to decimal for JSON. Pass-through if already decimal.
_dec() { local v="$1"; if [[ "$v" == 0x* || "$v" == 0X* ]]; then printf '%u' "$v"; else printf '%s' "$v"; fi; }

# JSON-encode a string. Uses jq if available, else basic escaping.
_jstr() {
    if command -v jq &>/dev/null; then
        printf '%s' "$1" | jq -Rs .
    else
        printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    fi
}

cmd="${1:-summary}"
shift 2>/dev/null || true

case "$cmd" in

    # ── Observe ──────────────────────────────────────────────────────────

    summary|s)
        _get "summary"
        ;;

    player|p)
        _get "player"
        ;;

    journal|j)
        limit="${1:-}"
        _get "journal${limit:+?limit=$limit}"
        ;;

    mobiles)
        _get "world/mobiles"
        ;;

    paperdoll)
        serial="$(_dec "${1:?Usage: uo paperdoll <serial>}")"
        _get "world/mobiles/$serial/paperdoll"
        ;;

    status)
        _get "status"
        ;;

    # ── Move ─────────────────────────────────────────────────────────────

    move|m)
        dir="${1:?Usage: uo move <direction> [run]}"
        run=false
        [[ "${2:-}" == "run" || "${2:-}" == "true" ]] && run=true
        _post "actions/move" "{\"direction\":\"$dir\",\"run\":$run}"
        ;;

    # walk <direction> <steps> [run]  — moves N steps with pacing
    walk|w)
        dir="${1:?Usage: uo walk <direction> <steps> [run]}"
        steps="${2:-1}"
        run=false
        [[ "${3:-}" == "run" ]] && run=true
        for ((i=0; i<steps; i++)); do
            _post "actions/move" "{\"direction\":\"$dir\",\"run\":$run}"
            [[ $i -lt $((steps-1)) ]] && sleep 0.4
        done
        ;;

    # goto <x> <y> [z]  — pathfind to world coordinates (A* around obstacles)
    goto)
        x="${1:?Usage: uo goto <x> <y> [z]}"
        y="${2:?Usage: uo goto <x> <y> [z]}"
        z="${3:-}"
        
        echo "Pathfinding to ($x, $y${z:+, $z})..."
        
        # Get current position
        get_position() {
            player_json=$(_get "player")
            echo "$player_json" | jq -r '[.x, .y, .z] | @tsv'
        }
        
        # Function to find nearest door
        find_nearest_door() {
            summary_text=$(_get "summary")
            # Extract doors from summary (lines starting with + followed by serial)
            echo "$summary_text" | grep "^  +" | grep -i "door" | head -1 | awk '{print $2}' | sed 's/0x//'
        }
        
        # Function to open a door by serial
        open_door() {
            door_serial="$1"
            if [[ -n "$door_serial" ]]; then
                echo "  Trying to open door $door_serial..."
                _post "actions/use" "{\"serial\":$(_dec "0x$door_serial")}" >/dev/null 2>&1
                sleep 0.5  # Wait for door to open
                return 0
            fi
            return 1
        }
        
        # Get initial position
        read start_x start_y start_z <<< "$(get_position)"
        
        # Send pathfind request
        if [[ -n "$z" ]]; then
            _post "actions/pathfind" "{\"x\":$x,\"y\":$y,\"z\":$z}" >/dev/null 2>&1
        else
            _post "actions/pathfind" "{\"x\":$x,\"y\":$y}" >/dev/null 2>&1
        fi
        
        # Monitoring variables
        check_interval=0.5  # seconds between position checks
        stuck_timeout=1.0   # seconds without movement = stuck
        max_timeout=30      # maximum total time
        retry_attempted=false  # Have we tried opening doors yet?
        stuck_start_time=""
        start_time=$(date +%s.%N)
        last_x=$start_x
        last_y=$start_y
        last_z=$start_z
        
        while true; do
            # Check total timeout
            current_time=$(date +%s.%N)
            elapsed=$(echo "$current_time - $start_time" | bc)
            if (( $(echo "$elapsed > $max_timeout" | bc -l) )); then
                echo "Pathfinding timed out after ${max_timeout}s" >&2
                exit 1
            fi
            
            # Get current position
            read curr_x curr_y curr_z <<< "$(get_position)"
            
            # Calculate distance to destination
            dx=$(echo "$curr_x - $x" | bc)
            dy=$(echo "$curr_y - $y" | bc)
            if [[ -n "$z" ]]; then
                dz=$(echo "$curr_z - $z" | bc)
            else
                dz=0
            fi
            distance=$(echo "sqrt($dx^2 + $dy^2 + $dz^2)" | bc)
            
            # Check if reached destination (within 1 tile)
            if (( $(echo "$distance <= 1.0" | bc -l) )); then
                echo "✓ Reached destination ($curr_x, $curr_y, $curr_z) - distance: ${distance%.*} tiles"
                exit 0
            fi
            
            # Check if moving
            moved_x=$(echo "$curr_x != $last_x" | bc)
            moved_y=$(echo "$curr_y != $last_y" | bc)
            moved_z=$(echo "$curr_z != $last_z" | bc)
            
            if [[ $moved_x -eq 1 || $moved_y -eq 1 || $moved_z -eq 1 ]]; then
                # Moving - reset stuck timer and retry flag
                stuck_start_time=""
                retry_attempted=false
                last_x=$curr_x
                last_y=$curr_y
                last_z=$curr_z
            else
                # Not moving - check if stuck
                if [[ -z "$stuck_start_time" ]]; then
                    stuck_start_time=$current_time
                else
                    stuck_elapsed=$(echo "$current_time - $stuck_start_time" | bc)
                    if (( $(echo "$stuck_elapsed > $stuck_timeout" | bc -l) )); then
                        # We're stuck! Try to open doors if we haven't already
                        if [[ "$retry_attempted" == "false" ]]; then
                            echo "Stuck at ($curr_x, $curr_y, $curr_z) - looking for doors..."
                            door_serial=$(find_nearest_door)
                            if open_door "$door_serial"; then
                                echo "  Door opened, retrying pathfinding..."
                                # Retry pathfinding
                                if [[ -n "$z" ]]; then
                                    _post "actions/pathfind" "{\"x\":$x,\"y\":$y,\"z\":$z}" >/dev/null 2>&1
                                else
                                    _post "actions/pathfind" "{\"x\":$x,\"y\":$y}" >/dev/null 2>&1
                                fi
                                retry_attempted=true
                                stuck_start_time=""  # Reset stuck timer
                                sleep 1  # Wait for pathfinding to restart
                                continue  # Skip to next iteration
                            else
                                echo "  No doors found nearby or failed to open"
                            fi
                        fi
                        
                        # If we already tried doors or no doors found, fail
                        echo "✗ Pathfinding stuck at ($curr_x, $curr_y, $curr_z)" >&2
                        echo "  Destination ($x, $y${z:+, $z}) is ${distance%.*} tiles away" >&2
                        echo "  Possible obstacles: walls, closed doors, impassable terrain" >&2
                        exit 1
                    fi
                fi
            fi
            
            sleep "$check_interval"
        done
        ;;

    # follow <serial> [--persistent] [interval] — pathfind to a mobile or item
    #   --persistent, -p: continuously follow (default interval: 1 second)
    follow)
        serial="$(_dec "${1:?Usage: uo follow <serial> [--persistent] [interval_seconds]}")"
        shift
        
        persistent=false
        interval=1
        
        # Parse optional arguments
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --persistent|-p)
                    persistent=true
                    shift
                    ;;
                *)
                    # Check if it's a number (interval)
                    if [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                        interval="$1"
                        shift
                    else
                        echo "Error: Unknown argument: $1" >&2
                        echo "Usage: uo follow <serial> [--persistent] [interval_seconds]" >&2
                        exit 1
                    fi
                    ;;
            esac
        done
        
        if [[ "$persistent" == "true" ]]; then
            echo "Following serial $serial persistently (checking every $interval seconds)"
            echo "Press Ctrl+C to stop, or run 'uo stopwalk' in another terminal"
            echo "Tip: Run with '&' to background: 'uo follow 0x123 --persistent &'"
            trap 'echo -e "\nStopped following."; exit 0' INT
            while true; do
                _post "actions/pathfind" "{\"serial\":$serial}" >/dev/null 2>&1
                sleep "$interval"
            done
        else
            _post "actions/pathfind" "{\"serial\":$serial}"
        fi
        ;;

    # stopwalk  — cancel any in-progress pathfinding
    stopwalk)
        _post "actions/stopwalk" '{}'
        ;;

    # ── Recovery ───────────────────────────────────────────────────────────

    # resync — request a full client/server state resync (clears stuck walk state)
    resync)
        _post "actions/resync" '{}'
        ;;

    # ── Speak ─────────────────────────────────────────────────────────────

    say)
        text="$(_jstr "${1:?Usage: uo say <text>}")"
        _post "actions/say" "{\"text\":$text}"
        ;;

    yell)
        text="$(_jstr "${1:?Usage: uo yell <text>}")"
        _post "actions/say" "{\"text\":$text,\"type\":\"yell\"}"
        ;;

    whisper)
        text="$(_jstr "${1:?Usage: uo whisper <text>}")"
        _post "actions/say" "{\"text\":$text,\"type\":\"whisper\"}"
        ;;

    emote|e)
        text="$(_jstr "${1:?Usage: uo emote <text>}")"
        _post "actions/say" "{\"text\":$text,\"type\":\"emote\"}"
        ;;

    # ── Interact ──────────────────────────────────────────────────────────

    use|u)
        serial="$(_dec "${1:?Usage: uo use <serial>}")"
        _post "actions/use" "{\"serial\":$serial}"
        ;;

    attack)
        serial="$(_dec "${1:?Usage: uo attack <serial>}")"
        _post "actions/attack" "{\"serial\":$serial}"
        ;;

    warmode)
        mode=true
        [[ "${1:-}" == "off" || "${1:-}" == "false" ]] && mode=false
        _post "actions/warmode" "{\"enabled\":$mode}"
        ;;

    # target <serial> | target <x> <y> <z> | target cancel
    target|t)
        arg="${1:?Usage: uo target <serial> | uo target <x> <y> <z> | uo target cancel}"
        if [[ "$arg" == "cancel" ]]; then
            _post "actions/target" '{"cancel":true}'
        elif [[ -n "${3:-}" ]]; then
            _post "actions/target" "{\"x\":$1,\"y\":$2,\"z\":$3}"
        else
            _post "actions/target" "{\"serial\":$(_dec "$arg")}"
        fi
        ;;

    # opendoor  — open the nearest door in the direction you are facing
    opendoor|od)
        _post "actions/opendoor" '{}'
        ;;

    # ── Containers & Inventory ─────────────────────────────────────────────

    # backpack — view contents of your backpack
    backpack|bp)
        _get "containers/backpack"
        ;;

    # container <serial> — view contents of a container
    container)
        serial="$(_dec "${1:?Usage: uo container <serial>}")"
        _get "containers/$serial"
        ;;

    # grab <serial> [amount] — pick up item and put in backpack
    grab|g)
        serial="$(_dec "${1:?Usage: uo grab <serial> [amount]}")"
        amount="${2:-0}"
        _post "actions/grab" "{\"serial\":$serial,\"amount\":$amount}"
        ;;

    # pickup <serial> [amount] — pick up item (puts in cursor for equipping)
    pickup)
        serial="$(_dec "${1:?Usage: uo pickup <serial> [amount]}")"
        amount="${2:--1}"
        _post "actions/pickup" "{\"serial\":$serial,\"amount\":$amount}"
        ;;

    # equip [container] — equip item currently held in cursor
    equip)
        container="${1:-}"
        if [[ -n "$container" ]]; then
            container="$(_dec "$container")"
            _post "actions/equip" "{\"container\":$container}"
        else
            _post "actions/equip" "{}"
        fi
        ;;

    # wander [radius] [center_x] [center_y] — random walk within radius
    wander)
        radius="${1:-5}"
        center_x="${2:-}"
        center_y="${3:-}"
        
        # Get current position if center not specified
        if [[ -z "$center_x" || -z "$center_y" ]]; then
            player_json=$(_get "player")
            center_x=$(echo "$player_json" | jq '.x')
            center_y=$(echo "$player_json" | jq '.y')
        fi
        
        echo "Wandering within radius $radius of ($center_x, $center_y)"
        echo "Press Ctrl+C to stop, or run 'uo stopwalk'"
        echo "Run with '&' to background: 'uo wander 5 &'"
        
        trap 'echo -e "\nStopped wandering."; exit 0' INT
        
        while true; do
            # Generate random offset within radius
            offset_x=$((RANDOM % (2*radius + 1) - radius))
            offset_y=$((RANDOM % (2*radius + 1) - radius))
            target_x=$((center_x + offset_x))
            target_y=$((center_y + offset_y))
            
            echo "Walking to ($target_x, $target_y)"
            _post "actions/pathfind" "{\"x\":$target_x,\"y\":$target_y}" >/dev/null 2>&1
            
            # Wait to reach destination or random time
            sleep $((3 + RANDOM % 5))
            
            # Check for gumps periodically (for resurrection)
            gumps=$(_get "gumps")
            if [[ "$gumps" != "[]" ]]; then
                echo "Gump detected! Check with 'uo gumps'"
                # Could auto-respond to resurrection gump here
            fi
        done
        ;;

    # combat <target_serial> [options] — fight with auto-healing/fleeing
    #   --heal-threshold=<percent>  (default: 50)
    #   --flee-threshold=<percent>  (default: 20)
    #   --check-interval=<seconds>  (default: 1)
    combat)
        target="$(_dec "${1:?Usage: uo combat <target_serial> [--heal-threshold=50] [--flee-threshold=20] [--check-interval=1]}")"
        shift
        
        heal_threshold=50
        flee_threshold=40
        check_interval=1
        
        # Parse options
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --heal-threshold=*)
                    heal_threshold="${1#*=}"
                    shift
                    ;;
                --flee-threshold=*)
                    flee_threshold="${1#*=}"
                    shift
                    ;;
                --check-interval=*)
                    check_interval="${1#*=}"
                    shift
                    ;;
                *)
                    echo "Error: Unknown option: $1" >&2
                    echo "Usage: uo combat <target> [--heal-threshold=50] [--flee-threshold=20] [--check-interval=1]" >&2
                    exit 1
                    ;;
            esac
        done
        
        echo "Starting combat with target $target"
        echo "Heal below ${heal_threshold}% HP, flee below ${flee_threshold}% HP"
        echo "Checking every ${check_interval} seconds"
        echo "Run with '&' to background: 'uo combat 0x123 --heal-threshold=50 &'"
        echo "Press Ctrl+C to stop, or run 'uo stopwalk' and 'uo warmode off'"
        
        # Enter warmode first
        _post "actions/warmode" "{\"enabled\":true}"
        sleep 0.5
        
        # Start attacking
        _post "actions/attack" "{\"serial\":$target}"
        
        trap 'echo -e "\nStopping combat."; _post "actions/warmode" "{\"enabled\":false}"; exit 0' INT
        
        # Find a bandage in backpack
        find_bandage() {
            backpack_json=$(_get "containers/backpack")
            # Look for item with graphic 3617 (bandage) or name containing "bandage"
            echo "$backpack_json" | jq -r '.items[] | select(.graphic == 3617 or (.name | ascii_downcase | contains("bandage"))) | .serial' | head -1
        }
        
        bandage_serial=$(find_bandage)
        if [[ -n "$bandage_serial" ]]; then
            echo "Found bandage: $bandage_serial"
        else
            echo "No bandages found in backpack"
        fi
        
        while true; do
            # Get player stats to check HP
            player_json=$(_get "player")
            hp_current=$(echo "$player_json" | jq '.stats.hits')
            hp_max=$(echo "$player_json" | jq '.stats.hitsMax')
            hp_percent=$(( (hp_current * 100) / hp_max ))
            
            if [[ $hp_percent -lt $flee_threshold ]]; then
                echo "HP at ${hp_percent}% - FLEEING!"
                _post "actions/warmode" "{\"enabled\":false}"
                _post "actions/stopwalk" "{}"
                echo "Combat stopped due to low HP"
                exit 0
            elif [[ $hp_percent -lt $heal_threshold && -n "$bandage_serial" ]]; then
                echo "HP at ${hp_percent}% - Using bandage $bandage_serial"
                # Use bandage (opens targeting cursor)
                _post "actions/use" "{\"serial\":$bandage_serial}"
                sleep 0.5
                # Target self (player serial is 0x00007AEB = 31467)
                _post "actions/target" "{\"serial\":31467}"
                sleep 12  # Bandage takes ~12 seconds to apply
                # Find another bandage if this one was used up
                bandage_serial=$(find_bandage)
                if [[ -z "$bandage_serial" ]]; then
                    echo "Out of bandages"
                fi
            fi
            
            # Re-attack if needed (in case target changes or combat stops)
            _post "actions/attack" "{\"serial\":$target}" >/dev/null 2>&1
            
            sleep "$check_interval"
        done
        ;;

    # drop <serial> [container_serial] — drop item on ground or into a container.
    # If the item is not currently held, it will be picked up automatically.
    # Ground items more than 3 tiles away will trigger pathfinding first.
    drop)
        serial="$(_dec "${1:?Usage: uo drop <serial> [container_serial]}")"
        container="${2:-}"

        # For ground items, move within range if too far
        item_json=$(_get "world/items/$serial")
        if [[ "$item_json" != "null" && -n "$item_json" ]]; then
            dist=$(echo "$item_json" | jq '.distance // 0')
            if [[ "$dist" -gt 3 ]]; then
                ix=$(echo "$item_json" | jq -r '.x')
                iy=$(echo "$item_json" | jq -r '.y')
                iz=$(echo "$item_json" | jq -r '.z')
                echo "Item is $dist tiles away. Moving closer..."
                bash "$0" goto "$ix" "$iy" "$iz" || { echo "Failed to reach item." >&2; exit 1; }
            fi
        fi

        if [[ -n "$container" ]]; then
            _post "actions/drop" "{\"serial\":$serial,\"container\":$(_dec "$container")}"
        else
            _post "actions/drop" "{\"serial\":$serial}"
        fi
        ;;

    # place <serial> [container_serial | x y z] — pick up and place an item.
    # If no destination is given, drops on the ground near the player.
    # Ground items more than 3 tiles away will trigger pathfinding first.
    place)
        serial="$(_dec "${1:?Usage: uo place <serial> [container_serial | x y z]}")"
        shift

        # For ground items, move within range if too far
        item_json=$(_get "world/items/$serial")
        if [[ "$item_json" != "null" && -n "$item_json" ]]; then
            dist=$(echo "$item_json" | jq '.distance // 0')
            if [[ "$dist" -gt 3 ]]; then
                ix=$(echo "$item_json" | jq -r '.x')
                iy=$(echo "$item_json" | jq -r '.y')
                iz=$(echo "$item_json" | jq -r '.z')
                echo "Item is $dist tiles away. Moving closer..."
                bash "$0" goto "$ix" "$iy" "$iz" || { echo "Failed to reach item." >&2; exit 1; }
            fi
        fi

        if [[ $# -eq 0 ]]; then
            # Drop on ground near player
            _post "actions/drop" "{\"serial\":$serial}"
        elif [[ $# -eq 1 ]]; then
            container="$(_dec "$1")"
            _post "actions/drop" "{\"serial\":$serial,\"container\":$container}"
        elif [[ $# -eq 2 || $# -eq 3 ]]; then
            x="$1"
            y="$2"
            z="${3:-0}"
            _post "actions/drop" "{\"serial\":$serial,\"x\":$x,\"y\":$y,\"z\":$z}"
        else
            echo "Usage: uo place <serial> [container_serial | x y z]" >&2
            exit 1
        fi
        ;;

    # ── Gumps (NPC dialogs, menus) ───────────────────────────────────────

    # gumps  — list all open server gumps
    gumps)
        _get "gumps"
        ;;

    # gump-respond <localSerial> <buttonID> [switches...]  — respond to a gump (button + optional checkbox selections)
    gump-respond|gr)
        serial="$(_dec "${1:?Usage: uo gump-respond <localSerial> <buttonID> [switches]}")"
        button="${2:?Usage: uo gump-respond <localSerial> <buttonID> [switches]}"
        switches="${3:-}"
        if [ -n "$switches" ]; then
            IFS=',' read -ra switch_arr <<< "$switches"
            switch_list="["
            first=true
            for s in "${switch_arr[@]}"; do
                s_trimmed="$(echo -n "$s" | tr -d '[:space:]')"
                [ "$first" = false ] && switch_list+=", "
                switch_list+="$s_trimmed"
                first=false
            done
            switch_list+="]"
            body="{\"buttonID\":$button,\"switches\":$switch_list,\"textEntries\":[]}"
        else
            body="{\"buttonID\":$button,\"switches\":[],\"textEntries\":[]}"
        fi
        _post "gumps/$serial/respond" "$body"
        ;;

    # gump-close <localSerial>  — close/cancel a gump
    gump-close|gc)
        serial="$(_dec "${1:?Usage: uo gump-close <localSerial>}")"
        curl -s -X DELETE "$BASE/gumps/$serial"
        ;;

    # ── Shop / Vendor ──────────────────────────────────────────────────────

    # shop  — view items in currently open vendor shop
    shop)
        _get "shop"
        ;;

    # buy <serial> [qty]  — buy an item from the open shop
    buy)
        serial="$(_dec "${1:?Usage: uo buy <serial> [quantity]}")"
        qty="${2:-1}"
        _post "shop/buy" "{\"items\":[{\"serial\":$serial,\"quantity\":$qty}]}"
        ;;

    # sell <serial> [qty]  — sell an item to the open shop
    sell)
        serial="$(_dec "${1:?Usage: uo sell <serial> [quantity]}")"
        qty="${2:-1}"
        _post "shop/sell" "{\"items\":[{\"serial\":$serial,\"quantity\":$qty}]}"
        ;;

    # ── Skills & Spells ───────────────────────────────────────────────────

    skill)
        idx="${1:?Usage: uo skill <index>}"
        _post "actions/skill" "{\"index\":$idx}"
        ;;

    cast|spell)
        idx="${1:?Usage: uo cast <spell_number>}"
        _post "actions/spell" "{\"index\":$idx}"
        ;;

    # ── Shortcuts ─────────────────────────────────────────────────────────

    meditate)   _post "actions/skill"  '{"index":46}' ;;  # Meditation
    nightsight) _post "actions/spell"  '{"index":6}'  ;;  # Night Sight (no reagents)
    heal)       _post "actions/spell"  '{"index":4}'  ;;  # Heal
    magiclock)  _post "actions/spell"  '{"index":23}' ;;  # Magic Lock

    # ── Help ──────────────────────────────────────────────────────────────

    help|--help|-h)
        cat <<'HELP'
uo — ClassicUO REST API wrapper

OBSERVE
  uo summary [or: uo s]         Full world view: map, entities, journal
  uo player  [or: uo p]         Detailed player stats and skills (JSON)
  uo journal [limit]            Recent journal entries (JSON)
  uo mobiles                    All visible mobiles (JSON)
  uo paperdoll <serial>         Equipment layers for a nearby mobile (JSON)
  uo status                     Connection state (JSON)

MOVE
  uo move <dir> [run]           One step. dir: north south east west ne se sw nw
  uo walk <dir> <n> [run]       n steps with pacing (~0.4s between steps)
  uo goto <x> <y> [z]          Pathfind to world coordinates (A* around obstacles)
  uo follow <serial> [--persistent] [interval]
                                Pathfind to mobile/item. Use -p for continuous follow
  uo stopwalk                   Cancel in-progress pathfinding

RECOVERY
  uo resync                     Request a full client/server state resync (clears stuck walk state)

SPEAK
  uo say    <text>              Say something aloud
  uo yell   <text>              Yell (wider broadcast range)
  uo whisper <text>             Whisper (adjacent only)
  uo emote  <text>              Emote (*Gemma looks around curiously*)

INTERACT
  uo use    <serial>            Double-click: open, talk-to, or activate
  uo opendoor                   Open nearest door in facing direction
  uo target <serial>            Target a mobile or item (after spell/skill)
  uo target <x> <y> <z>         Target ground coordinates
  uo target cancel              Cancel targeting cursor
  uo attack <serial>            Attack a mobile (enter war mode first)
  uo combat <serial> [options]  Fight with auto-flee at low HP
  uo warmode [on|off]           Toggle war/peace mode

CONTAINERS & INVENTORY
  uo backpack                   View your backpack contents (JSON)
  uo container <serial>         View contents of any container (JSON)
  uo grab <serial> [amount]     Pick up item and put in backpack
  uo pickup <serial> [amount]   Pick up item (puts in cursor for equipping)
  uo equip [container]          Equip item currently held in cursor
  uo drop <serial> [container]  Drop item into container or on ground (auto-pickup, auto-goto)
  uo place <serial> [dest]      Place item on ground, at coordinates, or into container

GUMPS (NPC dialogs, menus)
  uo gumps                      List all open server gumps (JSON)
  uo gump-respond <id> <btn> [switches]  Respond to a gump (button + optional comma-sep checkbox serials)
  uo gump-close <id>            Close/cancel a gump

SHOP / VENDOR
  uo shop                       View items in currently open vendor shop
  uo buy  <serial> [qty]        Buy item from open shop (say "vendor buy" first)
  uo sell <serial> [qty]        Sell item to open shop (say "vendor sell" first)

SKILLS & SPELLS
  uo skill <index>              Use a skill by index number
  uo cast  <spell#>             Cast a magery spell by number

SHORTCUTS
  uo meditate                   Meditation (skill 46) — regenerate mana
  uo nightsight                 Cast Night Sight (spell 6, no reagents needed)
  uo heal                       Cast Heal (spell 4)

SKILL INDEX QUICK REF
  0=Alchemy  16=Eval Int  17=Healing  23=Inscription
  25=Magery  46=Meditation  47=Stealth  49=Necromancy

SPELL INDEX QUICK REF (Magery)
  Circle 1: 1=Clumsy  2=Create Food  3=Feeblemind  4=Heal  5=Magic Arrow
            6=Night Sight  7=Reactive Armor  8=Weaken
  Circle 2: 9=Agility  10=Cunning  11=Cure  12=Harm  13=Magic Trap
            15=Protection  16=Strength
  Circle 3: 17=Bless  22=Fireball  23=Magic Lock  24=Poison
            26=Telekinesis  27=Teleport  28=Unlock  29=Wall of Stone
HELP
        ;;

    *)
        echo "Unknown command: $cmd. Try: uo help" >&2
        exit 1
        ;;
esac
