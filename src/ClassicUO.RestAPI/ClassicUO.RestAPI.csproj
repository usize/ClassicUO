<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cuo-api</AssemblyName>
    <RootNamespace>ClassicUO.RestApi</RootNamespace>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!-- Override PlatformTarget so ClassicUO.Client builds as AnyCPU (not x64-only)
       when used as a JIT dependency here. The x64 setting in its csproj is only
       needed for the native AOT publish via build-naot.sh. -->
  <ItemGroup>
    <ProjectReference Include="..\ClassicUO.Client\ClassicUO.Client.csproj">
      <AdditionalProperties>PlatformTarget=AnyCPU;PublishAot=false;OutputType=Library</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- cuoapi is a transitive reference from ClassicUO.Client but lands as type="reference"
       in the deps.json (compile-time only). Declare it directly here so the runtime
       includes it in assembly probing. -->
  <ItemGroup>
    <Reference Include="cuoapi">
      <HintPath>..\..\external\cuoapi\cuoapi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy native dylibs (FNA3D, SDL3, FAudio, etc.) to output directory.
       ClassicUO.Client's CopyExternalDeps_build copies them to its own output path,
       not the RestAPI's output, so we do it here explicitly. -->
  <Target Name="CopyNativeDylibs" AfterTargets="Build">
    <ItemGroup>
      <_OsxDylibs Include="$(MSBuildThisFileDirectory)..\..\external\osx\*.*" />
      <_VulkanIcd Include="$(MSBuildThisFileDirectory)..\..\external\vulkan\icd.d\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OsxDylibs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'" />
    <Copy SourceFiles="@(_VulkanIcd)" DestinationFolder="$(OutputPath)vulkan/icd.d/"
          SkipUnchangedFiles="true"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'" />
  </Target>
</Project>
